{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "nRF52-DK",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceRoot}/boards/nrf52dk/target/thumbv7em-none-eabi/release/nrf52dk",
            "target": "localhost:2331",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "gdbpath": "/home/patsv/Downloads/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",

"autorun": [
                "monitor reset",
                "monitor speed auto",
                "b initialize_ram_jump_to_main"
            ]
        },
        {
            "name": "MSP432 Cortex Debug",
            "type": "cortex-debug",
            "servertype": "openocd",
            "request": "launch",
            "executable": "${workspaceRoot}/target/thumbv7em-none-eabi/debug/msp-exp432p401r.elf",
            "cwd": "${workspaceRoot}",
            "svdFile": "${workspaceRoot}/boards/msp_exp432p401r/msp432.svd",
            "runToEntryPoint": "true",
            "configFiles": [
                "${workspaceRoot}/boards/msp_exp432p401r/openocd.cfg",
            ]
        },
        {
            "name": "Debug with OpenOCD Pico2",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/target/thumbv8m.main-none-eabi/release/raspberry_pi_pico2.elf",
          //  "executable": "${workspaceRoot}/target/thumbv8m.main-none-eabi/debug/raspberry_pi_pico2.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "showDevDebugOutput": "raw",
            "runToEntryPoint": "true",
            "debuggerArgs": [
                
            ],
        
            "gdbPath": "/home/patsv/Downloads/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
            "openOCDLaunchCommands": [
            "adapter speed 5000",
            "init;",
        
//        "rp2350.dap.core1 cortex_m reset_config sysresetreq;",
//        "rp2350.dap.core0 cortex_m reset_config sysresetreq;",
//        "rp2350.dap.core1  arp_reset assert 0 ;",
//        "rp2350.dap.core0 arp_reset assert 0 ;",
//        " rp2350.dap.core0 arp_halt;", 
//        "rp2350.dap.core1 arp_halt;"
            ],
            "presentation": {
                "hidden": false,
                "group": "",
                "order": 1
            },
            "breakAfterReset": true,
            "postLaunchCommands": [
                "set substitute-path  /rustc/827a0d638dabc9a22c56f9c37a557568f86ac76c/ /home/patsv/.rustup/toolchains/nightly-2025-02-19-x86_64-unknown-linux-gnu/lib/rustlib/src/rust/",
                "dir ~/.cargo/registry/src/",
                "dir ~/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/src/rust",
                "file /home/patsv/src/tock/target/thumbv8m.main-none-eabi/release/raspberry_pi_pico2.elf",
                "load /home/patsv/src/tock/target/thumbv8m.main-none-eabi/release/raspberry_pi_pico2.elf",
            ],
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350_eris.cfg"
            ],
            
            "searchDir": [
                "/home/patsv/src/pico/openocd/tcl/",
            //    "/usr/local/share/openocd/scripts/",
            ],
            "svdFile": "${env:PICO_SDK_PATH}/src/rp2350/hardware_regs/rp2350_eris.svd",
            
           // "runToEntryPoint": "_start",
            "postResetCommands": [
                "help"
            ],
    
            // Give restart the same functionality as runToEntryPoint - main
            "postRestartCommands": [
                "load /home/patsv/src/tock/target/thumbv8m.main-none-eabi/release/raspberry_pi_pico2.elf",
                "monitor init",
            ]
        },
